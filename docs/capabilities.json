  "notSupported": [
    {
      "what": "通用弹幕状态",
      "detail": "只能间接判断两类：自己名下的弹幕**数量**（远程攻击的凭证）、抓钩弹幕的**类型**（aiStyle 7）。拿不到任意弹幕的位置/速度/生命周期，读不到\"浮标有没有落水\"\"咬钩没咬钩\"这类状态。"
    },
    {
      "what": "生物 AI 内部状态",
      "detail": "可以列半径内 NPC 的类型/血量/坐标/是否敌对，但读不到目标、路径、攻击冷却、拾取意图。"
    },
    {
      "what": "随机事件与时机窗口",
      "detail": "没有任何\"等到某件事发生再动手\"的原语。现有命令都是「发一个动作 → 到点返回」，不支持「等随机时长 → 在窗口内做第二动作」（钓鱼、抓虫、躲冲撞都属于这一类）。"
    },
    {
      "what": "NPC 对话文本",
      "detail": "可以买东西、看商店清单，但读不到对话内容与任务进度。"
    },
    {
      "what": "容器以外的容器",
      "detail": "只能读 6 格内的箱子（list/take）。梳妆台、展示框、武器架、展示柜都读不到。"
    },
    {
      "what": "画面语义",
      "detail": "截图只能看像素（本机没前台也能抓），但不能识别\"这是什么怪\"\"这里黑不黑\"。一切判定必须落到 state / tile / inventory 这类数值上。"
    },
    {
      "what": "音效与事件字幕",
      "detail": "读不到游戏内提示文本（\"你感觉邪恶的东西在看着你\"之类），只能靠 boss/event 状态反推。"
    },
    {
      "what": "合成树自动规划",
      "detail": "能查配方、能按 id 合成，但不会自己把\"缺 3 个铁锭\"翻译成\"该去挖 9 个铁矿\"。要我自己推。"
    }
  ]
}
